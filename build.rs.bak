use std::{env, fs, path::Path};

fn main() {
    let out_dir = env::var("OUT_DIR").unwrap();
    let cmd_dir = Path::new("src/bin/vendor/fastboot");

    // Collect all *.rs files except mod.rs
    let mut modules: Vec<String> = fs::read_dir(cmd_dir)
        .expect("fastboot dir not found")
        .filter_map(|e| e.ok())
        .filter(|e| e.path().extension().and_then(|x| x.to_str()) == Some("rs"))
        .filter_map(|e| {
            let stem = e.path().file_stem()?.to_str()?.to_string();
            if stem == "mod" { None } else { Some(stem) }
        })
        .collect();

    modules.sort();

    let mut code = String::from("// Auto-generated by build.rs — do not edit.\n\n");

    // pub mod declarations
    for m in &modules {
        code.push_str(&format!("pub mod {m};\n"));
    }

    // REGISTRY static array
    code.push_str("\npub static REGISTRY: &[CommandEntry] = &[\n");
    for m in &modules {
        code.push_str(&format!(
            "    CommandEntry {{ name: {m}::CMD_NAME, aliases: {m}::CMD_ALIASES, help: {m}::CMD_HELP, run: {m}::run }},\n"
        ));
    }
    code.push_str("];\n");

    let out = Path::new(&out_dir).join("fastboot_registry.rs");
    fs::write(out, code).unwrap();

    // Re-run if any file in the directory changes
    println!("cargo:rerun-if-changed=src/bin/vendor/fastboot/");
}
